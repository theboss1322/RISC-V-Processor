module reg_file (
  input logic [4:0] a1, a2, a3,
  input logic [31:0] wd,
  input logic clk, we,
  output logic [31:0] rd1, rd2 );

  logic [31:0] reg_array [31:0];
  
  assign rd1 = (a1 != 5'b0) ? reg_array[a1] : 32'b0;
  assign rd2 = (a2 != 5'b0) ? reg_array[a2] : 32'b0;
  
  always_ff @(posedge clk) begin
    if (we) begin
      reg_array[a3] <= wd; 
    end
  end
endmodule
