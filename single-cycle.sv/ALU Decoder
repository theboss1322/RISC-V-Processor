module alu_decoder (
  input logic [2:0] funct3,
  input logic [1:0] ALUOp,
  input logic op_5, funct7_5,
  output logic [3:0] ALUControl );
  
 always_comb begin
   case (ALUOp)
     2'b00 : ALUControl = 4'b0000;
     2'b01 : begin
       casez (funct3)
         3'b00? : ALUControl = 4'b0001;
         3'b10? : ALUControl = 4'b0011;
         3'b11? : ALUControl = 4'b0101;
         default : ALUControl = 4'bxxxx;
       endcase
     end
     2'b10 : begin
       case (funct3)
         3'b000 : begin
           casez ({op_5, funct7_5})
             2'b10, 2'b0? : ALUControl = 4'b0000;
             2'b11 : ALUControl = 4'b0001;
             default : ALUControl = 4'bxxxx;
           endcase
         end
         3'b001 : ALUControl = 4'b1000;
         3'b010 : ALUControl = 4'b0011;
         3'b011 : ALUControl = 4'b0101;
         3'b100 : ALUControl = 4'b0110;
         3'b101 : begin
           casez ({op_5, funct7_5})
             2'b?0 : ALUControl = 4'b1001;
             2'b?1 : ALUControl = 4'b1010;
             default : ALUControl = 4'bxxxx;
           endcase
         end
         3'b110 : ALUControl = 4'b1011;
         3'b111 : ALUControl = 4'b0100;
         default : ALUControl = 4'bxxxx;
       endcase
     end
     default : ALUControl = 4'bxxxx;
   endcase
 end
endmodule
