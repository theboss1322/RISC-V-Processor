module main_decoder (
  input logic [6:0] op,
  input logic [2:0] funct3,
  input logic zero, ALUResult,
  output logic [2:0] ResultSrc, ImmSrc,
  output logic MemWrite, ALUSrc, RegWrite, branch,
  output logic [1:0] ALUOp, PCSrc, jump );
  
  logic [13:0] controls;
  assign {RegWrite, ImmSrc, ALUSrc, MemWrite, ResultSrc, ALUOp, PCSrc, branch, jump} = controls;
  
  logic branch_cond, take_branch;
  assign branch_cond = funct3[2] ? ALUResult : zero;
  assign take_branch = branch & (branch_cond ^ funct3[0]);
  
  assign PCSrc[1] = jump[1];
  assign PCSrc[0] = jump[0] | take_branch;
  
  always_comb begin
    case (op)
      7'b0000011: controls = 14'b1_000_1_0_001_00_0_00; // Loads
      7'b0100011: controls = 14'b0_001_1_1_xxx_00_0_00; // Stores
      7'b0110011: controls = 14'b1_xxx_0_0_000_10_0_00; // R-type
      7'b1100011: controls = 14'b0_010_0_0_xxx_01_1_00; // Branches
      7'b0010011: controls = 14'b1_000_1_0_000_10_0_00; // Itpe 
      7'b1101111: controls = 14'b1_011_x_0_010_xx_0_01; // jal
      7'b0010111: controls = 14'b1_100_x_0_011_xx_0_00; // auipc
      7'b0110111: controls = 14'b1_100_x_0_100_xx_0_00; // lui
      7'b1100111: controls = 14'b1_000_1_0_010_00_0_10; // jalr
      default   : controls = 14'b0_xxx_x_0_xxx_xx_0_00; // safety default
    endcase
  end
endmodule
